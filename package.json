{
  "name": "saloonos",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.61.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.20",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "api:typecheck": "tsc --noEmit -p apps/api/tsconfig.json",
    "api:dev": "npm run start:dev --workspace @salonos/api",
    "api:build": "npm run build --workspace @salonos/api",
    "api:test": "npm run test --workspace @salonos/api",
    "api:prisma:generate": "npm run prisma:generate --workspace @salonos/api",
    "api:prisma:migrate": "npm run prisma:migrate --workspace @salonos/api"
  }
}
