generator client {
  provider = "prisma-client-js"
}

model OfflineDevice {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(80)
  secretHash String @db.VarChar(64)
  registeredBy String @db.Uuid
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  grants OfflineGrant[]
  @@index([tenantId, active])
}

model OfflineGrant {
  id String @id @default(uuid()) @db.Uuid
  deviceId String @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  sessionId String @db.Uuid
  branchId String @db.Uuid
  shiftId String @db.Uuid
  issuedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  snapshot Json
  usedCount Int @default(0)
  usedAmountLkr Decimal @default(0) @db.Decimal(12,2)
  device OfflineDevice @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  operations OfflineOperation[]
  @@index([tenantId, userId])
  @@index([deviceId, expiresAt])
}

model OfflineOperation {
  id String @id @db.Uuid
  grantId String @db.Uuid
  payloadHash String @db.VarChar(64)
  state String @db.VarChar(20)
  result Json
  saleId String? @unique @db.Uuid
  recordedAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  grant OfflineGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)
  @@index([grantId, state])
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum RefundStatus {
  COMPLETED
  VOIDED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  saleId      String       @db.Uuid
  amountLkr   Decimal      @db.Decimal(12, 2)
  reason      String       @db.VarChar(255)
  status      RefundStatus @default(COMPLETED)
  createdByUserId String?  @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  idempotencyKey String    @db.VarChar(120)
  requestHash String       @db.VarChar(64)
  cashShiftId String?      @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  createdBy   User?        @relation("RefundCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cashShift   CashShift?   @relation(fields: [tenantId, cashShiftId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId, createdAt])
}

model CashShift {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  branchId      String          @db.Uuid
  openedByUserId String         @db.Uuid
  closedByUserId String?        @db.Uuid
  openingAmountLkr Decimal       @db.Decimal(12, 2)
  closingAmountLkr Decimal?      @db.Decimal(12, 2)
  status        CashShiftStatus @default(OPEN)
  openedAt      DateTime        @default(now()) @db.Timestamptz(3)
  closedAt      DateTime?       @db.Timestamptz(3)
  expectedClosingLkr Decimal?    @db.Decimal(12, 2)
  differenceLkr Decimal?         @db.Decimal(12, 2)
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  openedBy      User            @relation("ShiftOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy      User?           @relation("ShiftCloser", fields: [closedByUserId], references: [id], onDelete: SetNull)
  sales         Sale[]
  refunds       Refund[]
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status])
}

enum MembershipRole {
  OWNER
  MANAGER
  CASHIER
  STYLIST
}

enum CatalogItemType {
  SERVICE
  PRODUCT
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SaleStatus {
  OPEN
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(320)
  displayName  String       @db.VarChar(120)
  passwordHash String?      @db.VarChar(255)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  memberships  Membership[]
  staffProfiles StaffProfile[]
  sessions     Session[]
  auditLogs    AuditLog[]   @relation("AuditActor")
  createdSales Sale[]       @relation("SaleCreator")
  createdRefunds Refund[]   @relation("RefundCreator")
  openedShifts CashShift[]  @relation("ShiftOpener")
  closedShifts CashShift[]  @relation("ShiftCloser")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
}

model Tenant {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(160)
  slug         String        @unique @db.VarChar(80)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  memberships  Membership[]
  branches     Branch[]
  staffProfiles StaffProfile[]
  customers    Customer[]
  catalogItems CatalogItem[]
  appointments Appointment[]
  sales        Sale[]
  saleLines    SaleLine[]
  payments     Payment[]
  refunds      Refund[]
  sessions     Session[]
  auditLogs    AuditLog[]
  schedules    StaffSchedule[]
  timeOff      StaffTimeOff[]
  cashShifts   CashShift[]
}

model Membership {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tenantId, userId])
  @@index([userId])
}

model Branch {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String        @db.VarChar(160)
  code         String        @db.VarChar(40)
  address      String?       @db.VarChar(500)
  receiptCounter Int @default(0)
  stockPolicy String @default("REJECT") @db.VarChar(20)
  prices BranchPrice[]
  stocks StockBalance[]
  movements InventoryMovement[]
  timezone     String        @default("Asia/Colombo") @db.VarChar(64)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffProfiles StaffProfile[]
  appointments Appointment[]
  sales        Sale[]
  schedules    StaffSchedule[]
  timeOff      StaffTimeOff[]
  cashShifts   CashShift[]
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
}

model StaffProfile {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  branchId  String    @db.Uuid
  title     String?   @db.VarChar(120)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  appointments Appointment[]
  schedules    StaffSchedule[]
  timeOff      StaffTimeOff[]
  saleLines    SaleLine[]
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([tenantId, branchId])
}

model Customer {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  firstName    String        @db.VarChar(80)
  lastName     String?       @db.VarChar(80)
  phone        String?       @db.VarChar(32)
  email        String?       @db.VarChar(320)
  notes        String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sales        Sale[]
  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, phone])
}

model CatalogItem {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  name        String          @db.VarChar(160)
  description String?
  category    String?         @db.VarChar(80)
  type        CatalogItemType
  priceLkr    Decimal         @db.Decimal(12, 2)
  taxRateBps Int @default(0)
  taxLabel String @default("No tax") @db.VarChar(80)
  prices BranchPrice[]
  stocks StockBalance[]
  movements InventoryMovement[]
  durationMinutes Int?
  active      Boolean         @default(true)
  trackInventory Boolean      @default(false)
  stockQuantity Decimal        @default(0) @db.Decimal(10, 3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleLines   SaleLine[]
  appointments Appointment[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, type, active])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @db.Uuid
  branchId       String            @db.Uuid
  customerId     String            @db.Uuid
  serviceId      String?        @db.Uuid
  staffProfileId String?           @db.Uuid
  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(BOOKED)
  notes          String?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer       Customer          @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  service        CatalogItem?      @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  staffProfile   StaffProfile?     @relation(fields: [tenantId, staffProfileId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, customerId])
  @@index([tenantId, staffProfileId, startsAt, endsAt])
}

model StaffSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  staffId   String   @db.Uuid
  branchId  String   @db.Uuid
  dayOfWeek Int
  startsAt  String   @db.VarChar(5)
  endsAt    String   @db.VarChar(5)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, staffId, dayOfWeek])
  @@index([tenantId, branchId])
}

model StaffTimeOff {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  staffId   String   @db.Uuid
  branchId  String   @db.Uuid
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  branch    Branch   @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@index([tenantId, staffId, startsAt, endsAt])
}

model Sale {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  branchId    String      @db.Uuid
  customerId  String?     @db.Uuid
  status      SaleStatus  @default(OPEN)
  subtotalLkr Decimal     @db.Decimal(12, 2)
  discountLkr Decimal     @default(0) @db.Decimal(12, 2)
  taxLkr      Decimal     @default(0) @db.Decimal(12, 2)
  totalLkr    Decimal     @db.Decimal(12, 2)
  currency    String      @default("LKR") @db.Char(3)
  receiptNumber String    @db.VarChar(80)
  receiptSequence Int?
  branchName String? @db.VarChar(160)
  branchAddress String? @db.VarChar(500)
  customerName String? @db.VarChar(170)
  voidedAt DateTime? @db.Timestamptz(3)
  voidReason String? @db.VarChar(255)
  idempotencyKey String   @db.VarChar(120)
  requestHash String     @db.VarChar(64)
  cashShiftId String?    @db.Uuid
  cashReceivedLkr Decimal? @db.Decimal(12, 2)
  changeLkr Decimal?     @db.Decimal(12, 2)
  createdByUserId String? @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch      @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  customer    Customer?   @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  lines       SaleLine[]
  payments    Payment[]
  refunds     Refund[]
  createdBy   User?       @relation("SaleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  cashShift   CashShift?  @relation(fields: [tenantId, cashShiftId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, id])
  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, branchId, receiptSequence])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, branchId, createdAt])
}

model SaleLine {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  saleId        String      @db.Uuid
  catalogItemId String      @db.Uuid
  quantity      Decimal     @db.Decimal(10, 3)
  unitPriceLkr  Decimal     @db.Decimal(12, 2)
  lineTotalLkr  Decimal     @db.Decimal(12, 2)
  discountLkr Decimal @default(0) @db.Decimal(12,2)
  taxRateBps Int @default(0)
  taxLabel String @default("No tax") @db.VarChar(80)
  taxLkr Decimal @default(0) @db.Decimal(12,2)
  itemName      String      @db.VarChar(160)
  itemType      CatalogItemType
  inventoryDeducted Boolean @default(false)
  assignedStaffProfileId String? @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale          Sale        @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [tenantId, catalogItemId], references: [tenantId, id], onDelete: Restrict)
  assignedStaffProfile StaffProfile? @relation(fields: [tenantId, assignedStaffProfileId], references: [tenantId, id], onDelete: Restrict)
  @@index([tenantId, saleId])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  saleId      String        @db.Uuid
  amountLkr   Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?       @db.VarChar(120)
  status      PaymentStatus  @default(PENDING)
  idempotencyKey String?    @db.VarChar(120)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  verifiedAt  DateTime?     @db.Timestamptz(3)
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sale        Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, saleId])
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @db.Uuid
  tokenFamilyId     String   @db.Uuid
  refreshTokenHash  String   @unique @db.VarChar(255)
  replacedById      String?  @db.Uuid
  expiresAt         DateTime @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  lastUsedAt        DateTime? @db.Timestamptz(3)
  userAgent         String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([tenantId, userId])
  @@index([tokenFamilyId])
  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(80)
  entityId    String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model BranchPrice {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  itemId String @db.Uuid
  priceLkr Decimal @db.Decimal(12,2)
  taxRateBps Int @default(0)
  taxLabel String @default("No tax") @db.VarChar(80)
  active Boolean @default(true)
  branch Branch @relation(fields:[tenantId,branchId],references:[tenantId,id],onDelete:Cascade)
  item CatalogItem @relation(fields:[tenantId,itemId],references:[tenantId,id],onDelete:Cascade)
  @@id([tenantId,branchId,itemId])
}
model StockBalance {
  tenantId String @db.Uuid
  branchId String @db.Uuid
  itemId String @db.Uuid
  quantity Decimal @default(0) @db.Decimal(10,3)
  branch Branch @relation(fields:[tenantId,branchId],references:[tenantId,id],onDelete:Cascade)
  item CatalogItem @relation(fields:[tenantId,itemId],references:[tenantId,id],onDelete:Restrict)
  @@id([tenantId,branchId,itemId])
}
model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  branchId String @db.Uuid
  itemId String @db.Uuid
  delta Decimal @db.Decimal(10,3)
  balanceAfter Decimal @db.Decimal(10,3)
  kind String @db.VarChar(32)
  reason String @db.VarChar(255)
  actorUserId String? @db.Uuid
  saleId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  branch Branch @relation(fields:[tenantId,branchId],references:[tenantId,id],onDelete:Restrict)
  item CatalogItem @relation(fields:[tenantId,itemId],references:[tenantId,id],onDelete:Restrict)
  @@index([tenantId,branchId,createdAt])
}
model FinancialCommand {
  tenantId String @db.Uuid
  key String @db.VarChar(120)
  requestHash String @db.VarChar(64)
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([tenantId,key])
}
