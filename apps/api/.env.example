NODE_ENV=development
PORT=3000
API_PREFIX=v1
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/salonos?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.neon.tech/salonos?sslmode=require
LOG_LEVEL=info
APP_VERSION=0.1.0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT=10
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EMAIL_FROM=no-reply@salonos.local
