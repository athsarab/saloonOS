NODE_ENV=development
PORT=3000
API_PREFIX=v1
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/salonos?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.neon.tech/salonos?sslmode=require
LOG_LEVEL=info
APP_VERSION=0.1.0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
AUTH_RATE_LIMIT=10
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
EMAIL_FROM=your-sender@gmail.com
# Gmail: set EMAIL_FROM and SMTP_USER to the same Gmail address.
# Use a Google App Password, not your normal Google account password.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=
